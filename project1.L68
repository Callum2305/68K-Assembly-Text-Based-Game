000011B6                           271  ; CHECK_RANDOM_EVENTS
000011B6                           272  ; 20 % chance of mass loss per game. 30 % chance of lucky find per game. Once these events occur once, the flag is set, so we need to check the flag each time
000011B6                           273  ; Using number in D0 from random number generated (0 to 99), we check if it is in range 0 - 19 to go to mass loss, or 20 - 49 for lucky event. 99 for instant game over 1 % chance. Using BHS to skip over and check next event
000011B6                           274  ; as number is range 0 - 99, thats 100 numbers, so can pick a percentage chance based off what number it is
000011B6                           275  ;
000011B6                           276  ; 
000011B6                           277  *--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
000011B6                           278  CHECK_RANDOM_EVENTS:
000011B6  6100 FEB4                279      BSR     RANDOM_0_99     ; D0 will now contain a number of 0 - 99, based off time
000011BA                           280      
000011BA                           281      ; 1% break-in
000011BA  B03C 0063                282      CMP.B   #99,D0          ; compare 99 to D0, if they are the same, branch if equal to break in event, instant game over
000011BE  6700 00C0                283      BEQ     EVENT_BREAK_IN
000011C2                           284  
000011C2                           285      ; 20% chance mass loss (D0 equals number range 0 to 19), only once as checks flag
000011C2  B03C 0014                286      CMP.B   #20,D0              ; compare number in D0 with 20
000011C6  6400 0012                287      BHS     CHECK_LUCKY         ; BHS Branch if higher or same, to check for lucky event flag
000011CA  4A39 00001330            288      TST.B   FLAG_REDUCE_MASS    ; test if mass event flag is 0, meaning has it occured yet? This is the else case of the compare
000011D0  6600 0008                289      BNE     CHECK_LUCKY          ; if not equal, it means it has occured, then check if lucky event can occur
000011D4  6100 001E                290      BSR     EVENT_REDUCE_MASS   ; else if equal, branch to the reduce mass subroutine
000011D8  4E75                     291      RTS
000011DA                           292  
000011DA                           293  CHECK_LUCKY:
000011DA                           294      ; 30% chance lucky find (range 20 to 49), can only occur once due to flag i set
000011DA  B03C 0032                295      CMP.B   #50,D0                ; compare random number from D0 with 50
000011DE  6400 0012                296      BHS     NO_EVENT              ; BHS = Branch if higher or Same. so if 50 or above, it is out of event scope, and we move to no event for rts
000011E2  4A39 00001331            297      TST.B   FLAG_LUCKY_FIND       ; check if flag is = 0 if the number in D0 is less than 40
000011E8  6600 0008                298      BNE     NO_EVENT              ; if flag is equal to 1, then event already occured, brnach to no event for rts
000011EC  6100 002E                299      BSR     EVENT_LUCKY_FIND      ; if flag is 0, and if within event chance, branch to lucky find event subroutine
000011F0  4E75                     300      RTS
000011F2                           301  
000011F2                           302  NO_EVENT:
000011F2  4E75                     303      RTS                         ; if no event due to flags being set, rts to game loop again
