000011F4                           305  *--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
000011F4                           306  ;
000011F4                           307  ; RANDOM DAILY EVENTS
000011F4                           308  ; I need to be careful with these, so as not to allow mass or health to increase past 100, so i need to reset them if they do
000011F4                           309  ; As discussed with philip, i will use a counter, or flag, that increases once an event occurs. These are initialised to 0. If the event occurs, increase flag by 1.
000011F4                           310  ; Once the event flag for a specific event becomes 1, it can never happen again in that play through, preventing repeating events.
000011F4                           311  ;
000011F4                           312  *--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
000011F4                           313   
000011F4                           314  ; mass loss random event   
000011F4                           315  EVENT_REDUCE_MASS:
000011F4  6100 FE6A                316      BSR CLEAR_SCREEN        ; branch to clear screen
000011F8  43F9 000015A9            317      LEA MSG_MASS_LOSS, A1   ;Load event mass loss
000011FE  6100 FE48                318      BSR PRINT_STR           ; print message
00001202                           319      
00001202                           320      ; reduce mass by 10
00001202  1039 00001329            321      MOVE.B PLAYER_MASS, D0  ; move current mass to D0
00001208  0400 000A                322      SUB.B #10, D0           ; SUBTRACT 10 from current mass in D0
0000120C  13C0 00001329            323      MOVE.B D0, PLAYER_MASS  ; move newly updated mass back into variable
00001212                           324      
00001212  13FC 0001 00001330       325      MOVE.B #1, FLAG_REDUCE_MASS     ; set event flag to 1, as it has now occured
0000121A                           326      
0000121A                           327      
0000121A  4E75                     328      RTS
0000121C                           329    
0000121C                           330  ; mass and health gain +10 each random event  
0000121C                           331  EVENT_LUCKY_FIND:
0000121C  6100 FE42                332      BSR CLEAR_SCREEN        ; branch to clear screen
00001220  43F9 00001627            333      LEA MSG_LUCKY_FIND, A1  ; load lucky find event message
00001226  6100 FE20                334      BSR PRINT_STR           ; print message
0000122A                           335      
0000122A                           336      ; add 10 to mass
0000122A  1039 00001329            337      MOVE.B PLAYER_MASS, D0      ; move player mass to D0
00001230  0600 000A                338      ADD.B   #10, D0             ; ADD 10 to D0, which currently holds mass
00001234  13C0 00001329            339      MOVE.B  D0, PLAYER_MASS     ; move contents of D0, which is new mass, back into variable PLAYER_MASS to update it
0000123A                           340      
0000123A  0C39 0064 00001329       341      CMP.B #100, PLAYER_MASS     ; CHECK IF PLAYER MASS INCREASED BEYOND 100, if so its a problemo
00001242  6E00 0028                342      BGT MASS_OVER_LOAD          ; if mass > 100, branch to subroutine to reduce it back to 100, as we increased by 10
00001246                           343      
00001246                           344      ; add 10 to vigor/health
00001246  1039 00001328            345      MOVE.B PLAYER_HEALTH, D0    ; move player health to D0
0000124C  0600 000A                346      ADD.B #10, D0               ; increase by 10
00001250  13C0 00001328            347      MOVE.B D0, PLAYER_HEALTH    ; move contents of D0, whcih now hold new health, back into health variable
00001256                           348      
00001256  0C39 0064 00001328       349      CMP.B #100, PLAYER_HEALTH   ; check if health is greater than 100, to prevent overflow
0000125E  6E00 0016                350      BGT HEALTH_OVER_LOAD        ; if health > 100, branch to subroutine to reduce it back to 100, as we increased by 10
00001262                           351      
00001262                           352  
00001262  13FC 0001 00001331       353      MOVE.B #1, FLAG_LUCKY_FIND  ; set event flag to 1, as it has now occured
0000126A                           354      
0000126A  4E75                     355      RTS
0000126C                           356      
0000126C                           357  ;used only if mass exceeds 100 after event
0000126C                           358  MASS_OVER_LOAD:
0000126C  13FC 0064 00001329       359      MOVE.B #100, PLAYER_MASS    ; replace overloaded mass (probably 110 mass if you are here), with 100 (intented maximum)
00001274  4E75                     360      RTS
00001276                           361      
00001276                           362      
00001276                           363  ;used only if health exceeds 100 after event
00001276                           364  HEALTH_OVER_LOAD:
00001276  13FC 0064 00001328       365      MOVE.B #100, PLAYER_HEALTH    ; replace overloaded heath (probably 110 health if you are here), with 100 (intented maximum)
0000127E  4E75                     366      RTS
00001280                           367      
00001280                           368  
00001280                           369    
00001280                           370  ; random event, killed in sleep at night
00001280                           371  EVENT_BREAK_IN:
00001280  6100 FDDE                372      BSR CLEAR_SCREEN            ; branch to clear screen
00001284  43F9 00001744            373      LEA MSG_MURDER_EVENT, A1    ; Load effective message to murder message
0000128A  6100 FDBC                374      BSR PRINT_STR               ; Print message using subroutine
0000128E                           375      
0000128E  6000 0094                376      BRA GAME_END               ; END GAME AS KILLED during night
00001292                           377      
00001292                           378  *--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
00001292                           379  ;
00001292                           380  ; Beginning of AI assisted code:
00001292                           381  ;
00001292                           382  *--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
00001292                           383  
00001292                           384      
00001292                           385  ; Each day, enemy has different health, stored in ENEMY_HP_TABLE, basically an array
00001292                           386  ; array starts from 0, not 1, as indexing. need to subtract 1 to get position in array.
00001292                           387  ; we choose enemy health by day number, but array starts at 0, while day starts from 1. need to offset this
00001292                           388  GET_ENEMY_HP:
00001292  41F9 0000132B            389      LEA     ENEMY_HP_TABLE,A0   ; load effective address of enemy health array into A0. A0 will point to 55, first num in array
00001298  7000                     390      MOVEQ   #0,D0               ; clearing D0 to prevent garbage like issue with player health and mass like before
0000129A  1039 0000132A            391      MOVE.B  DAY,D0              ; move byte DAY counter into D0, which is now cleared. so load current day
000012A0  5300                     392      SUBQ.B  #1,D0               ; subtract 1 from D0 because array counts from 0 onwards, not 1. index positioning.
000012A2                           393  
000012A2                           394  ;loop though array using D0, which is 0-4 index of array
000012A2                           395  ;when loop finishes, A0 points to correct enemy health stat for the day, and D0 is equal to 0
000012A2                           396  HP_LOOP:
000012A2  4A00                     397      TST.B   D0                  ; test D0 to check if it is = 0, doesnt change D0, just checks and set zero flag
000012A4  6700 0008                398      BEQ     HP_FOUND            ; branch if equal to HP_FOUND as we are already at correct index flag. loop exit conditon
000012A8  5288                     399      ADDQ.L  #1,A0               ; increment A0 pointer by 1 byte. so incrementing moves pointer to next enemy health number in array
000012AA  5300                     400      SUBQ.B  #1,D0               ; subtract D0 by 1, which is index counter, so if D0 = 3 here, it then subtracts 1 and becomes D0=2. Counting down to zero
000012AC  60F4                     401      BRA     HP_LOOP             ; unconditional branch back into loop, remeber if d0 is = 0, thats the exit condition
000012AE                           402      
000012AE                           403  ;loop finds correct hp stat for enemy each day, once found, we must store it somewhere to be used for combat comparisons
000012AE                           404  HP_FOUND:
000012AE  7400                     405      MOVEQ   #0,D2               ; move quick immediate value into D2, sets all bits of D2 to zero, clearing it off any waste or garbage bytes
000012B0  1410                     406      MOVE.B  (A0),D2             ; Move content of A0, which is current enemy health stat, into D2. so D2 = enemy hp
000012B2  4E75                     407      RTS                         ; return to subroutine
000012B4                           408      
000012B4                           409      
000012B4                           410  *--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
000012B4                           411  ;
000012B4                           412  ; Ending of AI assisted code:
000012B4                           413  ;
000012B4                           414  *--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
000012B4                           415      
000012B4                           416      
000012B4                           417  ;If player chose to venture out, they will encounter an enemy. this is the combat sequence.
000012B4                           418  ; to win, player must have higher vigor/health than the enemy. use compare to check.
000012B4                           419  COMBAT_DAY:
000012B4  43F9 00001417            420      LEA     MSG_COMBAT_INTRO,A1     ; load effective address of combat intro into A1
000012BA  6100 FD8C                421      BSR     PRINT_STR               ; branch to print subroutine to display message
000012BE                           422  
000012BE  61D2                     423      BSR     GET_ENEMY_HP            ; branch to get enemy hp subroutine above, to select enemy vigor/hp based on day coutner
000012C0                           424  
000012C0                           425      ; Show enemy HP
000012C0  43F9 00001564            426      LEA     MSG_ENEMY_HP,A1     ; load address of enemy hp message into a1
000012C6  6100 FD80                427      BSR     PRINT_STR           ; use print subroutine to display it
000012CA  4241                     428      CLR.W   D1                  ; clear d1 to prevent garbage
000012CC  1202                     429      MOVE.B  D2,D1               ; move D2 to D1. D2 holds enemy hp from HP_lOOP and HP_Found function, must move to D1 to print
000012CE  103C 0003                430      MOVE.B  #3,D0               ; move 3 to D0 for trap, prints number stored in D1
000012D2  4E4F                     431      TRAP    #15                 ; kernal call to display enemy hp number which is now in D1
000012D4  43F9 0000191F            432      LEA     CRLF,A1             ; load effecitve address of new line message to A1
000012DA  6100 FD6C                433      BSR     PRINT_STR           ; use print to print the new blank line
000012DE                           434  
000012DE                           435      ; Compare: if player health > enemy health, then you defeat them
000012DE  1039 00001328            436      MOVE.B  PLAYER_HEALTH,D0    ; move player vigor/health to D0
000012E4  B002                     437      CMP.B   D2,D0               ; compare D2 with D0
000012E6  6E00 0010                438      BGT     COMBAT_WIN          ; if d0/ player health is greater, branch if greater to combat win
000012EA                           439  
000012EA                           440      ; lose combat, you die and print death message.
000012EA  43F9 0000281C            441      LEA     MSG_DEAD,A1         ; load death message game over
000012F0  6100 FD56                442      BSR     PRINT_STR           ; print it with the subroutine
000012F4  6000 002E                443      BRA     GAME_END            ; unconditional branch to game over, as now player is dead
000012F8                           444    
000012F8                           445  ;if player wins combat, increase mass but decrease health
000012F8                           446  COMBAT_WIN:
000012F8                           447      ; minus 10 helth when defeated enemy
000012F8  1039 00001328            448      MOVE.B  PLAYER_HEALTH,D0    ;move player health to d0
000012FE  0400 000A                449      SUB.B   #10,D0              ; subtract 10 from player health as you tookn damage from enemy
00001302  13C0 00001328            450      MOVE.B  D0,PLAYER_HEALTH    ; move new health in D0 after subtraction back into PLAYER_HEALTH variable, overwriting it to reflect change
00001308                           451  
00001308                           452      ; gain 10 mass when defeated enemy
00001308  1039 00001329            453      MOVE.B  PLAYER_MASS,D0      ; move player mass to D0
0000130E  0600 000F                454      ADD.B   #15,D0              ; add 15 to increase current mass
00001312  13C0 00001329            455      MOVE.B  D0,PLAYER_MASS      ; move new mass stored in D0 back into PLAYER_MASS variable, overwriting previous player mass
00001318                           456  
00001318  43F9 00001572            457      LEA     MSG_WIN_COMBAT,A1   ; load effective address of victory/survival message to A1
0000131E  6100 FD28                458      BSR     PRINT_STR           ; branch to subroutine to print message to screen
00001322  4E75                     459      RTS                         ; return to subroutine and begin next day
00001324                           460      
00001324                           461      
00001324                           462  *--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
00001324                           463  ;
00001324                           464  ; Game Over, I branch here after displaying appropriate endings to end program with SIMHAULT
00001324                           465  ;
00001324                           466  *--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
00001324                           467  
00001324                           468  GAME_END:
00001324  FFFF FFFF                469      SIMHALT                 ; end program
