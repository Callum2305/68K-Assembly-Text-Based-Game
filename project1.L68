0000106C                           114  RANDOM_0_99:
0000106C  103C 0008                115      MOVE.B  #8,D0      ; trap task 8 = time since midnight
00001070  4E4F                     116      TRAP    #15        ; trap reads task in D0, which will put time since midnight into D1, so D1.L = time value
00001072  2001                     117      MOVE.L  D1,D0      ; copy time into D0 so we can trip it down. currently it is a long number
00001074                           118  
00001074                           119      ; ai assisted part, DIVU, SWAP AND ANDI
00001074  80FC 0064                120      DIVU    #100,D0    ; divide by 100, DIVU provides a remainder and a quotuient, so upper word is remainder, lower is quotient. I want the remainder
00001078  4840                     121      SWAP    D0         ; swap the remainder and quotient around, so remainder is in the lower word
0000107A  0240 00FF                122      ANDI.W  #$00FF,D0  ; bitwise and immediate to mask value, keeping only lower 8 bits and clears rest of lower word, so can only be left with number in range 0 - 99
0000107E                           123      
0000107E  4E75                     124      RTS                ; return to subroutine, with a value 0 - 99 stored in D0
